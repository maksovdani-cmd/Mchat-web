# ───────── Основное ─────────
NODE_ENV=development
PORT=3000
# Публичный адрес сайта БЕЗ слэша в конце. В проде — только https://
APP_URL=http://localhost:3000
# Для docker compose (см. ниже) переопределяется автоматически
DATABASE_URL=postgresql://mchat:mchat@localhost:5432/mchat

# Секрет подписи JWT и хэширования кодов. Сгенерировать: npm run secret
JWT_SECRET=

# ───────── Google OAuth (console.cloud.google.com → APIs & Services → Credentials) ─────────
# Authorized redirect URI:  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ───────── Web Push (ключи: npm run vapid) ─────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ───────── Почта (только для запасного кода «на почту») ─────────
# Без SMTP в dev код печатается в консоль сервера. В проде без SMTP запасной путь не работает.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mchat <no-reply@your-domain.com>

# ───────── Прочее ─────────
# Email-адреса админов через запятую (получают роль ADMIN при входе)
ADMIN_EMAILS=
# true — на экране кода есть кнопка «Отправить код на почту». Для максимальной строгости поставь false.
ALLOW_EMAIL_FALLBACK=true
# Сколько прокси перед приложением (Caddy/nginx = 1)
TRUST_PROXY=1

# ───────── Только для docker-compose ─────────
DOMAIN=mchat.example.com
DB_PASSWORD=change-me-long-random
