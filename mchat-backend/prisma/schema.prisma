generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
  /// «Избранное»: личный чат пользователя с самим собой (заметки, пересланное, файлы)
  SAVED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageKind {
  TEXT
  VOICE
  VIDEO_NOTE
  IMAGE
  VIDEO
  FILE
  /// служебная карточка завершённого звонка (JSON в text); создаётся только сервером
  CALL
}

enum MediaKind {
  VOICE
  VIDEO_NOTE
  IMAGE
  TRACK
  VIDEO
  FILE
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

model User {
  id             String   @id @default(cuid())
  googleId       String   @unique
  email          String   @unique
  username       String   @unique // всегда lowercase, [a-z0-9_]{3,20}
  name           String
  bio            String   @default("")
  avatarUrl      String?
  /// обложка профиля (URL загруженной картинки)
  bannerUrl      String?
  /// id своего трека (Media kind=TRACK), название которого показывается под ником в профиле
  musicTrack     String?
  verified       Boolean  @default(false)
  /// когда выдали галочку и до какого момента она действует (null = навсегда)
  verifiedAt     DateTime?
  verifiedUntil  DateTime?
  role           Role     @default(USER)

  /// Титул «Генерал Mchat» (пурпурная звезда рядом с ником). Выдаётся и забирается только админом, навсегда.
  generalTitle        Boolean   @default(false)
  generalGrantedAt    DateTime?
  /// когда человек увидел торжественный экран; null при generalTitle=true — экран ещё надо показать
  generalCelebratedAt DateTime?
  /// оформление звезды: «яркость.анимация», например «normal.pulse». Цвет менять нельзя, убрать звезду нельзя.
  generalStyle        String?

  // настройки (соответствуют тумблерам в UI)
  notifyMessages Boolean  @default(true)
  hideOnline     Boolean  @default(false)
  hideRead       Boolean  @default(false)
  /// скрыть, на кого я подписан (другие не видят список «Подписки»)
  hideFollowing  Boolean  @default(false)

  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  devices        Device[]
  sessions       Session[]
  loginCodes     LoginCode[]
  memberships    ChatMember[]
  messages       Message[]
  pushSubs       PushSubscription[]
  media          Media[]
  reactions      Reaction[]
  hiddenMessages MessageHide[]
  friendsSent     Friendship[] @relation("FriendRequester")
  friendsReceived Friendship[] @relation("FriendAddressee")
  following       Follow[]     @relation("Follower")
  followers       Follow[]     @relation("Following")
  channelComments ChannelComment[]
  posts          Post[]
  postLikes      PostLike[]
  postComments   PostComment[]
  postCommentLikes PostCommentLike[]
  viewOnceViews  ViewOnceView[]
  postReposts    PostRepost[]
  stories        Story[]
  verifyRequests VerifyRequest[]
  storyLikes     StoryLike[]
  storyComments  StoryComment[]
  blocksMade     Block[]      @relation("Blocker")
  blocksGot      Block[]      @relation("Blocked")
  savedTracks    SavedTrack[]
  callLogs       CallLogUser[]
  callsStarted   CallLog[]
  moments        Moment[]
  momentViews    MomentView[]
  momentComments MomentComment[]
}

/// Доверенное устройство. Пока устройство известно — код при входе не нужен.
model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique // sha256 от секрета в httpOnly cookie
  label       String    @default("") // «Chrome · Windows»
  ip          String    @default("")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?

  sessions    Session[]
  pushSubs    PushSubscription[]

  @@index([userId])
}

/// Конкретная сессия (JWT ссылается на неё через sid) — можно отозвать мгновенно.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([deviceId])
}

/// Одноразовый код входа с нового устройства (хранится только хэш).
model LoginCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  label      String    @default("") // описание нового устройства
  ip         String    @default("")
  attempts   Int       @default(0)
  emailSent  Boolean   @default(false)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Chat {
  id            String       @id @default(cuid())
  type          ChatType     @default(DIRECT)
  title         String?
  /// для DIRECT: "<меньший id>:<больший id>" — не даёт создать дубль диалога
  directKey     String?      @unique
  description   String?
  /// аватарка группы/канала (файл Media, kind=IMAGE)
  avatarMediaId String?
  /// ссылка-приглашение для групп и каналов: /join/<inviteCode>
  inviteCode    String?      @unique
  /// публичный канал: находится глобальным поиском, вступить можно одной кнопкой
  isPublic      Boolean      @default(false)
  /// закреплённое сообщение (одно на чат)
  pinnedMessageId String?
  /// исчезающие сообщения: через сколько секунд удалять (null — выключено). Сейчас используется значение 86400 (24 часа)
  autoDeleteSec Int?
  /// действует только для сообщений, отправленных после этого момента
  autoDeleteFrom DateTime?
  createdAt     DateTime     @default(now())
  lastMessageAt DateTime     @default(now())

  members       ChatMember[]
  messages      Message[]

  @@index([lastMessageAt])
}

model ChatMember {
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole @default(MEMBER)
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())
  /// личный фон чата: preset:N | media:<id картинки> | avatar (фото из профиля)
  background String?
  /// уведомления этого чата выключены (переключатель «Вкл/Выкл» у канала)
  muted      Boolean  @default(false)
  /// «глушить до»: null при muted=true — навсегда; иначе уведомления вернутся после этого времени
  mutedUntil DateTime?
  /// чат закреплён вверху списка (только для этого участника); время закрепления — для порядка
  pinnedAt   DateTime?
  /// «Удалить чат» из моего списка: сообщения до этого момента мне не показываем; новое сообщение вернёт чат в список
  hiddenAt   DateTime?

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  kind      MessageKind @default(TEXT)
  text      String    @default("")
  mediaId   String?
  media     Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  durationSec Int?
  /// Одноразовое медиа (фото/видео/голосовое/кружок): получатель открывает один раз, после закрытия файл и сообщение удаляются
  viewOnce         Boolean   @default(false)
  viewOnceOpenedAt DateTime?
  viewOnceOpenedBy String?
  replyToId String?
  replyTo   Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("Replies")
  /// имя автора оригинала, если сообщение переслано
  forwardedFromName String?
  /// id, который генерирует клиент — защита от дублей при повторной отправке
  clientId  String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  reactions Reaction[]
  hides     MessageHide[]
  viewOnceViews ViewOnceView[]
  comments  ChannelComment[]

  @@unique([senderId, clientId])
  @@index([chatId, createdAt])
  @@index([mediaId])
}

/// Загруженный файл: голосовое, кружок, фото или трек профиля.
model Media {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind        MediaKind
  mime        String
  size        Int
  title       String?
  durationSec Int?
  /// имя файла на диске внутри UPLOAD_DIR (не путь!)
  file        String
  /// отправлено в режиме HD (фото/видео в высоком качестве) — в чате показывается значок HD
  hd          Boolean   @default(false)
  /// постоянный публичный URL файла в облачном хранилище (S3/Supabase); null — файл на диске
  url         String?
  createdAt   DateTime  @default(now())

  messages    Message[]
  posts       Post[]    @relation("PostMedia")
  postThumbs  Post[]    @relation("PostThumb")
  stories     Story[]
  momentsMedia Moment[] @relation("MomentMedia")
  momentsTrack Moment[] @relation("MomentTrack")
  savedBy     SavedTrack[]

  @@index([ownerId, kind])
}

/// Одна реакция пользователя на сообщение (новая заменяет прежнюю, повтор снимает).
model Reaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId])
}

/// «Удалить у меня»: сообщение скрыто только для этого пользователя.
model MessageHide {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model Friendship {
  id           String       @id @default(cuid())
  requesterId  String
  requester    User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId  String
  addressee    User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       FriendStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}


/// Пост в ленте: текст + (фото | видео с обложкой). Приватный виден только автору (архив).
model Post {
  id         Int      @id @default(autoincrement())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text       String   @default("")
  mediaId    String?
  media      Media?   @relation("PostMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  /// 'image' | 'video'
  mediaType  String?
  thumbId    String?
  thumb      Media?   @relation("PostThumb", fields: [thumbId], references: [id], onDelete: SetNull)
  /// 'public' | 'private'
  privacy    String   @default("public")
  createdAt  DateTime @default(now())

  likes      PostLike[]
  comments   PostComment[]
  reposts    PostRepost[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostLike {
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  /// ответ на другой комментарий; если оригинал удалят — ссылка обнулится, а снимок автора и текста останется
  replyToId       Int?
  replyTo         PostComment?  @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         PostComment[] @relation("CommentReplies")
  replyToUsername String?
  replyToText     String?
  likes           PostCommentLike[]

  @@index([postId, createdAt])
}

model PostRepost {
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId, createdAt])
}

/// История: живёт 24 часа. Оформление (текстовые блоки, фон) хранится как JSON.
model Story {
  id         Int      @id @default(autoincrement())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaId    String?
  media      Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  /// 'image' | 'video'
  mediaType  String?
  bg         String?
  textBlocks Json     @default("[]")
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  likes      StoryLike[]
  comments   StoryComment[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model StoryLike {
  storyId Int
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
}

model PostCommentLike {
  commentId Int
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([commentId, userId])
}

/// Одноразовое медиа: у каждого получателя своё состояние просмотра (в группах получателей много)
model ViewOnceView {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openedAt  DateTime @default(now())
  closedAt  DateTime?

  @@id([messageId, userId])
  @@index([messageId])
}

model StoryComment {
  id        Int      @id @default(autoincrement())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([storyId, createdAt])
}


enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Запрос на галочку. Админ выбирает срок при одобрении (5/10/15/30 дней или навсегда).
model VerifyRequest {
  id        Int          @id @default(autoincrement())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    VerifyStatus @default(PENDING)
  createdAt DateTime     @default(now())
  decidedAt DateTime?
  /// на сколько дней одобрено (null = навсегда); имеет смысл только для APPROVED
  days      Int?

  @@index([status, createdAt])
  @@index([userId])
}

/// Подписка: followerId подписан на followingId. Взаимные подписки = «Друзья».
model Follow {
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

/// Комментарий под постом канала («Прокомментировать»). Писать могут все участники.
model ChannelComment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
}


/// Чёрный список: blockerId заблокировал blockedId (личные сообщения, звонки и подписка между ними закрыты).
model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Трек из чужого профиля, который пользователь сохранил себе (можно слушать и ставить в свой профиль).
model SavedTrack {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, mediaId])
  @@index([userId, createdAt])
}

enum CallLogStatus {
  /// разговор состоялся (есть длительность)
  ENDED
  /// никто не ответил / звонящий сбросил до ответа
  MISSED
  /// собеседник отклонил
  DECLINED
}

/// История звонков. Живой звонок хранится в памяти сервера, а после завершения пишется сюда.
model CallLog {
  id          String        @id @default(cuid())
  callId      String        @unique
  chatId      String
  initiatorId String?
  initiator   User?         @relation(fields: [initiatorId], references: [id], onDelete: SetNull)
  video       Boolean       @default(false)
  isGroup     Boolean       @default(false)
  title       String        @default("")
  status      CallLogStatus
  startedAt   DateTime
  answeredAt  DateTime?
  endedAt     DateTime
  durationSec Int           @default(0)

  users       CallLogUser[]

  @@index([chatId, startedAt])
}

/// Кого касался звонок (звонящий и все приглашённые) и вошёл ли он в разговор.
model CallLogUser {
  callLogId   String
  callLog     CallLog @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  joined      Boolean @default(false)
  durationSec Int     @default(0)

  @@id([callLogId, userId])
  @@index([userId])
}

/// «Момент» — гибрид истории и стены: свежий контент подсвечивается 24 часа, дальше остаётся на стене как хроника.
model Moment {
  id              Int      @id @default(autoincrement())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text            String   @default("")
  mediaId         String?
  media           Media?   @relation("MomentMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  /// 'image' | 'video'
  mediaType       String?
  /// трек дня (Media kind=TRACK) и его название на момент публикации
  trackId         String?
  track           Media?   @relation("MomentTrack", fields: [trackId], references: [id], onDelete: SetNull)
  trackTitle      String?
  commentsEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())

  views           MomentView[]
  comments        MomentComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

/// Уникальный просмотр: один человек (включая автора) — одна запись.
model MomentView {
  momentId Int
  moment   Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([momentId, userId])
  @@index([userId])
}

model MomentComment {
  id        Int      @id @default(autoincrement())
  momentId  Int
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([momentId, createdAt])
}