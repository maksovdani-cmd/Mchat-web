{
  "name": "mchat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mchat backend: Google OAuth + device codes, chats over Socket.IO, Web Push",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "vapid": "web-push generate-vapid-keys",
    "secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\"",
    "db:push": "prisma db push",
    "start:prod": "prisma db push --skip-generate && node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@prisma/client": "^6.19.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.1",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
